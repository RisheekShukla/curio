# Copy to .env.local and fill in. Leave Supabase values empty to run in demo mode.

# Public URL used for link previews (Open Graph). Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# --- Supabase (optional; enables cloud storage + email sign-in) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used solely to cache AI-generated starter questions on curated discoveries.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (optional; any OpenAI-compatible Chat Completions API) ---
# Server-only. Never prefix these with NEXT_PUBLIC_.
# Google Gemini (free tier): AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_MODEL=gemini-3.8-flash  AI_REASONING_EFFORT=low  AI_MAX_OUTPUT_TOKENS=4000
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Optional: tried once if the main model is overloaded (503) or rate limited (429), e.g. gemini-3.5-flash.
AI_FALLBACK_MODEL=
# Optional: only for "thinking" models. Leave empty for providers that don't support it.
AI_REASONING_EFFORT=
# Optional: raise for thinking models, whose reasoning tokens count toward the limit.
AI_MAX_OUTPUT_TOKENS=

# Demo mode uses deterministic mock answers in production builds unless this is "true".
DEMO_ALLOW_LIVE_AI=false

# Forces demo mode even when Supabase variables are set (used by the e2e tests).
CURIO_FORCE_DEMO=
